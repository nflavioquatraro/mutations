{
  "name": "mutations-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/sync-assets.mjs",
    "predev": "npm run prepare:assets",
    "dev": "astro dev",
    "prebuild": "npm run prepare:assets",
    "build": "npm run test:content && astro check && astro build && npm run test:pages",
    "test:content": "node --experimental-strip-types scripts/verify-content.mjs",
    "test:pages": "node scripts/verify-pages-build.mjs",
    "test:search": "node --experimental-strip-types scripts/verify-search.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "astro": "^7.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
