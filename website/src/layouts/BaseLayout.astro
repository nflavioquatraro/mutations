---
import Brand from "../components/Brand.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  showChrome?: boolean;
}

const {
  title = "Mutations — Bounded Architectural Adaptation",
  description = "A framework for modular, routed adaptations around frozen language models.",
  pageClass = "",
  showChrome = true,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = Astro.site ? new URL("/og.png", Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f9fb" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/logo/mutations-mark.png" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>

    {showChrome && (
      <header class="site-header">
        <a class="brand-link" href="/" aria-label="Mutations home">
          <Brand />
        </a>

        <nav class="primary-nav" aria-label="Primary navigation">
          <a href="/docs/">Docs</a>
          <a href="/paper.pdf">Paper</a>
          <a href="https://github.com/nflavioquatraro/mutations" rel="noreferrer">GitHub</a>
        </nav>
      </header>
    )}

    <slot />
  </body>
</html>
