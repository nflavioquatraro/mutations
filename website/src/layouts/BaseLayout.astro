---
import Brand from "../components/Brand.astro";
import type { Breadcrumb } from "../components/docs/Breadcrumbs.astro";
import { project } from "../data/site";
import { sitePath } from "../lib/site-path";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  showChrome?: boolean;
  breadcrumbs?: Breadcrumb[];
  article?: boolean;
}

const {
  title = project.title,
  description = project.description,
  pageClass = "",
  showChrome = true,
  breadcrumbs = [],
  article = false,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = Astro.site ? new URL(sitePath("og.png?v=2"), Astro.site) : undefined;
const ogImageAlt = "Mutations — modular adaptations around frozen language models.";
const homeUrl = Astro.site ? new URL(sitePath(), Astro.site).href : undefined;
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const structuredData = canonical && homeUrl
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${homeUrl}#website`,
          url: homeUrl,
          name: project.name,
          alternateName: project.alternateNames,
          description: project.description,
          inLanguage: "en",
        },
        {
          "@type": article ? "TechArticle" : "WebPage",
          "@id": `${canonical.href}#webpage`,
          url: canonical.href,
          name: title,
          ...(article ? { headline: title, author: project.author } : {}),
          description,
          inLanguage: "en",
          isPartOf: { "@id": `${homeUrl}#website` },
          about: { "@id": `${homeUrl}#software` },
          ...(breadcrumbs.length > 1
            ? { breadcrumb: { "@id": `${canonical.href}#breadcrumb` } }
            : {}),
        },
        ...(canonical.href === homeUrl
          ? [{
              "@type": "SoftwareSourceCode",
              "@id": `${homeUrl}#software`,
              name: project.name,
              alternateName: project.alternateNames,
              description: project.description,
              url: homeUrl,
              codeRepository: project.repository,
              programmingLanguage: "Python",
              runtimePlatform: "Python 3.10+",
              license: `${project.repository}/blob/main/LICENSE`,
              author: project.author,
              isAccessibleForFree: true,
            }]
          : []),
        ...(breadcrumbs.length > 1
          ? [{
              "@type": "BreadcrumbList",
              "@id": `${canonical.href}#breadcrumb`,
              itemListElement: breadcrumbs.map((item, index) => ({
                "@type": "ListItem",
                position: index + 1,
                name: item.name,
                item: new URL(sitePath(item.path), Astro.site).href,
              })),
            }]
          : []),
      ],
    }
  : undefined;
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replace(/</g, "\\u003c")
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f9fb" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <link rel="icon" type="image/png" href={sitePath("logo/mutations-mark.png")} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" type="application/xml" href={sitePath("sitemap.xml")} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={project.name} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:type" content="image/png" />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <title>{title}</title>
    {serializedStructuredData && <script is:inline type="application/ld+json" set:html={serializedStructuredData} />}
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>

    {showChrome && (
      <header class="site-header">
        <a class="brand-link" href={sitePath()} aria-label="Mutations home">
          <Brand />
        </a>

        <nav class="primary-nav" aria-label="Primary navigation">
          <a href={sitePath("docs/")}>Docs</a>
          <a href={sitePath("paper.pdf")}>Paper</a>
          <a href="https://github.com/nflavioquatraro/mutations" rel="noreferrer">GitHub</a>
        </nav>
      </header>
    )}

    <slot />
  </body>
</html>
