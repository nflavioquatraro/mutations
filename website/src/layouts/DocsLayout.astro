---
import Brand from "../components/Brand.astro";
import Breadcrumbs from "../components/docs/Breadcrumbs.astro";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import DocumentPagination from "../components/docs/DocumentPagination.astro";
import MobileDocsNavigation from "../components/docs/MobileDocsNavigation.astro";
import TableOfContents from "../components/docs/TableOfContents.astro";
import BaseLayout from "./BaseLayout.astro";
import {
  getDocumentNeighbors,
  getOrderedDocs,
  repositorySourceUrl,
  type DocsEntry,
} from "../lib/docs";
import type { MarkdownHeading } from "astro";
import { sitePath } from "../lib/site-path";

interface Props {
  entry: DocsEntry;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const breadcrumbs = [
  { name: "Mutations", path: "" },
  { name: "Documentation", path: "docs/" },
  { name: entry.data.title, path: `docs/${entry.id}/` },
];
const entries = await getOrderedDocs();
const neighbors = getDocumentNeighbors(entries, entry.id);
const reviewed = new Intl.DateTimeFormat("en", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(entry.data.last_reviewed);
---

<BaseLayout
  title={`${entry.data.seo_title} — Mutations`}
  description={entry.data.description}
  pageClass="docs-article-page"
  showChrome={false}
  breadcrumbs={breadcrumbs}
  article
>
  <header class="docs-header article-header">
    <a href={sitePath()} aria-label="Mutations home"><Brand compact /></a>
    <nav aria-label="Documentation navigation">
      <a class="current" href={sitePath("docs/")} aria-current="page">Docs</a>
      <a href={sitePath("paper.pdf")}>Paper</a>
      <a href="https://github.com/nflavioquatraro/mutations" rel="noreferrer">GitHub</a>
    </nav>
  </header>

  <MobileDocsNavigation
    currentEntry={entry}
    entries={entries}
    headings={headings}
    reviewed={reviewed}
  />

  <div class="docs-workspace">
    <DocsSidebar currentEntry={entry} entries={entries} reviewed={reviewed} />

    <main id="main-content" class="article-shell">
      <Breadcrumbs items={breadcrumbs} />
      <header class="article-title">
        <p class="section-kicker">
          {String(entry.data.order).padStart(2, "0")} / {entry.data.group}
        </p>
        <h1>{entry.data.seo_title}</h1>
        <p>{entry.data.description}</p>
        <div class="article-sources" aria-label="Page sources">
          <span>Sources</span>
          {entry.data.source.map((source) => (
            <a href={repositorySourceUrl(source)} rel="noreferrer">
              {source}
            </a>
          ))}
        </div>
      </header>

      <article class="prose">
        <slot />
      </article>

      <DocumentPagination neighbors={neighbors} />
    </main>

    <TableOfContents headings={headings} />
  </div>

  <script>
    document.addEventListener("keydown", (event) => {
      if (
        !(event.target instanceof HTMLElement) ||
        event.target.tagName !== "SUMMARY" ||
        (event.key !== "Enter" && event.key !== " ")
      ) {
        return;
      }

      const details = event.target.parentElement;
      if (!(details instanceof HTMLDetailsElement)) return;

      // Preserve native disclosure behavior while normalizing keyboard
      // activation in browser environments that do not toggle summary keys.
      event.preventDefault();
      details.open = !details.open;
    });
  </script>
</BaseLayout>
