---
import Brand from "../components/Brand.astro";
import BaseLayout from "./BaseLayout.astro";
import {
  repositorySourceUrl,
  type DocsEntry,
} from "../lib/docs";

interface Props {
  entry: DocsEntry;
}

const { entry } = Astro.props;
const reviewed = new Intl.DateTimeFormat("en", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(entry.data.last_reviewed);
---

<BaseLayout
  title={`${entry.data.title} — Mutations`}
  description={entry.data.description}
  pageClass="docs-article-page"
  showChrome={false}
>
  <header class="docs-header article-header">
    <a href="/" aria-label="Mutations home"><Brand compact /></a>
    <nav aria-label="Documentation navigation">
      <a class="current" href="/docs/" aria-current="page">Docs</a>
      <a href="/paper.pdf">Paper</a>
      <a href="https://github.com/nflavioquatraro/mutations" rel="noreferrer">GitHub</a>
    </nav>
  </header>

  <aside class="article-rail" aria-label="Document context">
    <a href="/docs/">← Documentation</a>
    <span>{entry.data.group}</span>
    <span>Reviewed {reviewed}</span>
  </aside>

  <main id="main-content" class="article-shell">
    <header class="article-title">
      <p class="section-kicker">
        {String(entry.data.order).padStart(2, "0")} / {entry.data.group}
      </p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <div class="article-sources" aria-label="Page sources">
        <span>Sources</span>
        {entry.data.source.map((source) => (
          <a href={repositorySourceUrl(source)} rel="noreferrer">
            {source}
          </a>
        ))}
      </div>
    </header>

    <article class="prose">
      <slot />
    </article>
  </main>

  <script>
    document.addEventListener("keydown", (event) => {
      if (
        !(event.target instanceof HTMLElement) ||
        event.target.tagName !== "SUMMARY" ||
        (event.key !== "Enter" && event.key !== " ")
      ) {
        return;
      }

      const details = event.target.parentElement;
      if (!(details instanceof HTMLDetailsElement)) return;

      event.preventDefault();
      details.open = !details.open;
    });
  </script>
</BaseLayout>
