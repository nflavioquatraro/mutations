---
import type { DocumentNeighbors } from "../../lib/docs";
import { sitePath } from "../../lib/site-path";

interface Props {
  neighbors: DocumentNeighbors;
}

const { neighbors } = Astro.props;
---

<nav class="document-pagination" aria-label="Documentation pages">
  {
    neighbors.previous ? (
      <a class="document-pagination-link previous" href={sitePath(`docs/${neighbors.previous.id}/`)}>
        <span>Previous</span>
        <strong>{neighbors.previous.data.title}</strong>
      </a>
    ) : (
      <a class="document-pagination-link previous" href={sitePath("docs/")}>
        <span>Documentation</span>
        <strong>All guides</strong>
      </a>
    )
  }

  {
    neighbors.next ? (
      <a class="document-pagination-link next" href={sitePath(`docs/${neighbors.next.id}/`)}>
        <span>Next</span>
        <strong>{neighbors.next.data.title}</strong>
      </a>
    ) : (
      <span class="document-pagination-end">
        <span>Current collection</span>
        <strong>More guides are in progress</strong>
      </span>
    )
  }
</nav>
