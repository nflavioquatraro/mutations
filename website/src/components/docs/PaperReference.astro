---
import {
  getReference,
  type ReferenceId,
} from "../../data/references";
import { sitePath } from "../../lib/site-path";

interface Props {
  referenceId: ReferenceId;
  purpose?: string;
  difference?: string;
  showRelated?: boolean;
}

const {
  referenceId,
  purpose: purposeOverride,
  difference: differenceOverride,
  showRelated = false,
} = Astro.props;
const reference = getReference(referenceId);
const purpose = purposeOverride ?? reference.purpose;
const difference = differenceOverride ?? reference.difference;
---

<article
  class="paper-reference"
  id={showRelated ? `reference-${referenceId}` : undefined}
  aria-label={`Reference: ${reference.title}`}
>
  <header>
    <p>{reference.authors} · {reference.year}</p>
    <h3>{reference.title}</h3>
    <a href={reference.href} rel="noreferrer">
      {reference.sourceLabel}
      <span aria-hidden="true">↗</span>
    </a>
  </header>

  <dl>
    <div>
      <dt>Why it matters here</dt>
      <dd>{purpose}</dd>
    </div>
    <div>
      <dt>How Mutations differs</dt>
      <dd>{difference}</dd>
    </div>
    {
      showRelated && (
        <div class="related-docs">
          <dt>Read it in context</dt>
          <dd>
            {reference.relatedDocs.map((document, index) => (
              <>
                {index > 0 && <span aria-hidden="true"> · </span>}
                <a href={sitePath(document.href)}>{document.label}</a>
              </>
            ))}
          </dd>
        </div>
      )
    }
  </dl>
</article>

<style>
  .paper-reference {
    max-width: var(--docs-reading-measure);
    margin: 1rem 0;
    border: 1px solid var(--hairline);
    background: rgba(248, 249, 251, 0.76);
  }

  header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.45rem 1.5rem;
    padding: 1.15rem;
    border-bottom: 1px solid var(--hairline);
  }

  header p {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--ink-soft);
    font: 650 0.59rem/1.4 var(--font-mono);
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  h3 {
    align-self: center;
    margin: 0;
    color: var(--ink-dark);
    font-size: 1.05rem;
    font-weight: 550;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  header a {
    align-self: center;
    color: var(--ink);
    font: 700 0.63rem/1.4 var(--font-mono);
    letter-spacing: 0.035em;
    white-space: nowrap;
  }

  header a span {
    margin-left: 0.25rem;
  }

  dl {
    display: grid;
    margin: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  dl > div {
    padding: 1rem 1.15rem;
  }

  dl > div + div {
    border-left: 1px solid var(--hairline);
  }

  dl > .related-docs {
    grid-column: 1 / -1;
    border-top: 1px solid var(--hairline);
    border-left: 0;
  }

  dt {
    margin-bottom: 0.45rem;
    color: var(--ink);
    font: 700 0.57rem/1.4 var(--font-mono);
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: #4e6e8f;
    font-size: 0.83rem;
    line-height: 1.55;
  }

  .related-docs a {
    font-weight: 700;
  }

  @media (max-width: 600px) {
    header {
      grid-template-columns: 1fr;
      padding: 0.95rem;
    }

    header p {
      grid-column: auto;
    }

    header a {
      justify-self: start;
      min-height: 2.75rem;
      align-content: center;
    }

    .related-docs a {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
    }

    dl {
      grid-template-columns: 1fr;
    }

    dl > div {
      padding: 0.95rem;
    }

    dl > div + div {
      border-top: 1px solid var(--hairline);
      border-left: 0;
    }
  }
</style>
