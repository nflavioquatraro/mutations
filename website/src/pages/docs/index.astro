---
import Brand from "../../components/Brand.astro";
import DocsSearch from "../../components/docs/DocsSearch.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  buildDocumentationSearchIndex,
  getOrderedDocs,
  groupDocumentationEntries,
} from "../../lib/docs";

const docs = await getOrderedDocs();
const groupedDocs = groupDocumentationEntries(docs);
const searchRecords = await buildDocumentationSearchIndex(docs);
---

<BaseLayout
  title="Documentation — Mutations"
  description="Package-aligned documentation for the Mutations anchored plug-in Mixture-of-Experts framework."
  pageClass="docs-page"
  showChrome={false}
>
  <header class="docs-header">
    <a href="/" aria-label="Mutations home"><Brand compact /></a>
    <nav aria-label="Documentation navigation">
      <a class="current" href="/docs/" aria-current="page">Docs</a>
      <a href="/paper.pdf">Paper</a>
      <a href="https://github.com/nflavioquatraro/mutations" rel="noreferrer">GitHub</a>
    </nav>
  </header>

  <main id="main-content" class="docs-index">
    <div class="docs-intro">
      <p class="section-kicker">Framework documentation</p>
      <h1>From stable anchor<br /><span>to routed capability.</span></h1>
      <div class="docs-intro-copy">
        <p>
          Learn the system from its exact fallback invariant through package
          composition, calibration, routing, and evaluation.
        </p>
        <p class="docs-rollout-note">
          Documentation is being published in validated slices. Pages can grow
          workflow by workflow; upcoming sections are identified explicitly.
        </p>
      </div>
    </div>

    <DocsSearch records={searchRecords} />

    <div class="docs-groups">
      {groupedDocs.map(({ group, entries }) => {
        const groupId = `group-${group.toLowerCase().replaceAll(" ", "-")}`;

        return (
          <section class="docs-group" aria-labelledby={groupId}>
            <header>
              <p>{String(entries[0].data.order).padStart(2, "0")}</p>
              <h2 id={groupId}>{group}</h2>
            </header>
            <div class="docs-list">
              {entries.map((entry) => (
                <a class="doc-row" href={`/docs/${entry.id}/`}>
                  <span class="doc-index">
                    {String(entry.data.order).padStart(2, "0")}
                  </span>
                  <span class="doc-title">
                    <strong>{entry.data.title}</strong>
                    <small>{entry.data.description}</small>
                  </span>
                  <span class="doc-meta">
                    {entry.data.feature_ids.length > 0
                      ? `${entry.data.feature_ids.length} tracked features`
                      : "Project guide"}
                  </span>
                  <span class="doc-arrow" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </main>
</BaseLayout>
