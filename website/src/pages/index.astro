---
import BaseLayout from "../layouts/BaseLayout.astro";
import MutationOrbital from "../components/MutationOrbital.astro";
import { getOrderedDocs } from "../lib/docs";
import { sitePath } from "../lib/site-path";

const documentationGuideCount = (await getOrderedDocs()).length;
---

<BaseLayout pageClass="home-page">
  <div class="technical-field" aria-hidden="true">
    <div class="field-circle"></div>
    <div class="field-orbit field-orbit-a"></div>
    <div class="field-orbit field-orbit-b"></div>
  </div>

  <main id="main-content" class="story" data-story>
    <section class="panel panel-orbital is-active" id="orbital" data-panel data-index="1">
      <div class="panel-inner hero-inner">
        <p class="section-kicker">Mutations / Anchored Plug-in MoE</p>
        <h1>
          MoE and LoRA.<br />
          <span>One frozen LLM.</span>
        </h1>
        <p class="hero-summary">
          A Python research framework for Mixture-of-Experts routing, LoRA adapters,
          and modular language-model specialization. Train independent specialists
          while preserving an exact base-model fallback.
        </p>
        <div class="hero-actions">
          <a class="text-link" href={sitePath("docs/getting-started/")}>Get started <span>→</span></a>
          <a class="text-link text-link-muted" href={sitePath("docs/examples/")}>Compare workflows <span>→</span></a>
          <a class="text-link text-link-muted" href={sitePath("paper.pdf")}>Read the paper <span>↗</span></a>
        </div>
        <nav class="hero-workflows" aria-label="Specialization workflows">
          <a href={sitePath("docs/experts/")}>MoE experts</a>
          <a href={sitePath("docs/adapters/")}>LoRA adapters</a>
          <a href={sitePath("docs/browser-deployment/")}>Browser LLMs</a>
        </nav>
      </div>
      <div class="hero-orbital-visual">
        <MutationOrbital />
      </div>
    </section>

    <section class="panel panel-architecture" id="architecture" data-panel data-index="2">
      <div class="panel-inner architecture-inner">
        <div class="section-heading reveal">
          <p class="section-kicker">02 / Architecture</p>
          <h2>One stable base.<br /><span>Mutations on demand.</span></h2>
          <p>
            Route tokens through packaged Qwen3 experts, select prompt-level LoRA
            adapters, or deploy Needle response branches. Each path keeps an explicit
            frozen-model fallback.
          </p>
        </div>

        <div class="route-map reveal" aria-label="Mutations routing architecture">
          <div class="route-node route-input">
            <span>01</span>
            <strong>Prompt</strong>
            <small>task state</small>
          </div>
          <div class="route-line route-line-in" aria-hidden="true"></div>
          <div class="route-node route-router">
            <span>02</span>
            <strong>Router</strong>
            <small>select path</small>
          </div>
          <div class="route-branches" aria-hidden="true"></div>
          <div class="route-node route-base">
            <span>A</span>
            <strong>Frozen base</strong>
            <small>general behavior</small>
          </div>
          <div class="route-node route-mutation">
            <span>B</span>
            <strong>Specialist path</strong>
            <small>specialized support</small>
          </div>
        </div>

        <div class="principles reveal">
          <div><span>01</span><strong>Frozen</strong><small>Base weights remain intact.</small></div>
          <div><span>02</span><strong>Routed</strong><small>Extra capacity is selective.</small></div>
          <div><span>03</span><strong>Reversible</strong><small>Adaptations can be retired.</small></div>
        </div>
      </div>
    </section>

    <section class="panel panel-experiment" id="experiment" data-panel data-index="3">
      <div class="panel-inner experiment-inner">
        <div class="section-heading reveal">
          <p class="section-kicker">03 / Validated baseline</p>
          <h2>From exact fallback<br /><span>to routed specialization.</span></h2>
          <p>
            The framework validates dense-equivalent conversion and a complete packaged
            anchored top-1 lifecycle. Advanced routes remain explicit composable or research
            paths until their model-level lifecycle is complete.
          </p>
        </div>

        <a class="diagram-window reveal" href={sitePath("architecture.png")} aria-label="Open the full architecture diagram">
          <img src={sitePath("architecture.png")} alt="MoE architecture with a frozen language model, expert router, and specialist MLPs" loading="lazy" />
          <span class="diagram-label">Architecture / full view ↗</span>
        </a>

        <dl class="experiment-spec reveal">
          <div><dt>Base invariant</dt><dd>Exact anchor fallback</dd></div>
          <div><dt>Lifecycle</dt><dd>Install / remove / reload</dd></div>
          <div><dt>Integrated route</dt><dd>Anchored top-1</dd></div>
          <div><dt>Advanced routes</dt><dd>Composable primitives</dd></div>
        </dl>
      </div>
    </section>

    <section class="panel panel-read" id="read" data-panel data-index="4">
      <div class="panel-inner read-inner">
        <div class="section-heading reveal">
          <p class="section-kicker">04 / Read and inspect</p>
          <h2>An open research<br /><span>scaffold.</span></h2>
          <p>
            The repository contains the framework paper, package-aligned guides,
            verified examples, and runnable training and evaluation notebooks.
          </p>
        </div>

        <div class="resource-grid reveal">
          <a class="resource-card resource-card-primary" href={sitePath("paper.pdf")}>
            <span class="resource-number">P / 19 pages</span>
            <strong>Framework paper</strong>
            <p>Definitions, runtime protocol, mutation lifecycle, and the research program.</p>
            <span class="resource-arrow">Open PDF ↗</span>
          </a>
          <a class="resource-card" href={sitePath("docs/")}>
            <span class="resource-number">D / {documentationGuideCount} guides</span>
            <strong>MoE and LoRA guides</strong>
            <p>Qwen3 conversion, expert training, routing policies, and Needle/WASM deployment.</p>
            <span class="resource-arrow">Browse docs →</span>
          </a>
          <a class="resource-card" href="https://github.com/nflavioquatraro/mutations" rel="noreferrer">
            <span class="resource-number">G / Source</span>
            <strong>GitHub repository</strong>
            <p>Inspect the Python package, tests, examples, notebooks, and project history.</p>
            <span class="resource-arrow">View GitHub ↗</span>
          </a>
        </div>

        <footer class="home-footer reveal">
          <span>Nicola Flavio Quatraro / Independent research</span>
          <span>MIT licensed</span>
        </footer>
      </div>
    </section>
  </main>

  <div class="fixed-caption" aria-hidden="true">
    <span>Bounded adaptation</span>
    <span>Frozen base / modular change</span>
  </div>

  <nav class="section-rail" aria-label="Homepage sections">
    <a href="#orbital" aria-label="Go to section 1" data-dot="1" class="active"></a>
    <a href="#architecture" aria-label="Go to section 2" data-dot="2"></a>
    <a href="#experiment" aria-label="Go to section 3" data-dot="3"></a>
    <a href="#read" aria-label="Go to section 4" data-dot="4"></a>
  </nav>

  <div class="section-counter" aria-live="polite">
    <span data-current>01</span><span class="counter-line">—</span><span>04</span>
  </div>

  <script>
    const story = document.querySelector<HTMLElement>("[data-story]");
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-panel]"));
    const current = document.querySelector<HTMLElement>("[data-current]");
    const dots = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-dot]"));

    const setActive = (panel: HTMLElement) => {
      const index = panel.dataset.index ?? "1";
      panels.forEach((item) => item.classList.toggle("is-active", item === panel));
      dots.forEach((dot) => dot.classList.toggle("active", dot.dataset.dot === index));
      if (current) current.textContent = index.padStart(2, "0");
      document.documentElement.style.setProperty("--section-progress", `${Number(index) - 1}`);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target instanceof HTMLElement) setActive(visible.target);
      },
      { root: story, threshold: [0.45, 0.65, 0.85] },
    );

    panels.forEach((panel) => observer.observe(panel));

    window.addEventListener("keydown", (event) => {
      if (!story || !["ArrowDown", "ArrowUp", "PageDown", "PageUp"].includes(event.key)) return;
      const activeIndex = panels.findIndex((panel) => panel.classList.contains("is-active"));
      const direction = event.key === "ArrowDown" || event.key === "PageDown" ? 1 : -1;
      const target = panels[Math.max(0, Math.min(panels.length - 1, activeIndex + direction))];
      if (!target || target === panels[activeIndex]) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  </script>
</BaseLayout>
